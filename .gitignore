# Replit
.cache/
.local/

# Vercel
.vercel
# Generated at build time by artifacts/api-server/scripts/build-vercel-api.mjs
# (bundled Express app for the Vercel serverless function). Never commit
# this — it's regenerated fresh on every deploy and goes stale instantly.
/api/*.mjs
/api/*.mjs.map
